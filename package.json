{
  "name": "motion-lab",
  "version": "1.0.0",
  "description": "Motion Lab - Local Animation Suite for Video Production with HyperFrames",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "doctor": "tsx scripts/doctor.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "e2e": "tsx scripts/e2e-proof.ts",
    "determinism": "tsx scripts/determinism-check.ts",
    "acceptance": "tsx scripts/run-acceptance-test.ts",
    "proof:render": "tsx scripts/render-proof.ts",
    "check:render-ui": "tsx scripts/render-ui-check.ts",
    "check:offline": "tsx scripts/check-offline.ts",
    "check:layout": "tsx scripts/check-layout.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/diff": "^7.0.2",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gsap": "3.15.1",
    "hyperframes": "^0.9.29",
    "lucide-react": "^1.16.0",
    "monaco-editor": "0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
