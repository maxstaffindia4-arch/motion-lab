# Server Configuration (binds to 127.0.0.1 only)
PORT=3000
HOST=127.0.0.1

# Default Provider: gemini | anthropic | agent
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Free-tier safeguards: exponential backoff + jitter on 429/503, sequential variations
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_RPM=15

# Anthropic Claude Configuration (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Agent Bridge Configuration (Google Antigravity CLI / IDE)
AGENT_CLI=antigravity
AGENT_BIN="C:\\Users\\Max\\AppData\\Local\\Programs\\Antigravity IDE\\bin\\antigravity-ide.cmd"
AGENT_CMD_TEMPLATE="{bin} chat --mode agent {prompt}"
AGENT_MODEL=inherit
AGENT_TIMEOUT_SEC=180

# FFmpeg and Tools (Auto-detected if on system or portable)
FFMPEG_PATH="C:\\Program Files\\DownloadHelper CoApp\\ffmpeg.exe"
FFPROBE_PATH="C:\\Program Files\\DownloadHelper CoApp\\ffprobe.exe"